Dialogue: 0,0:00:01.66,0:00:04.42,Default,,0,0,0,,Düşünmeye başladım da. Ya eğer…
Dialogue: 0,0:00:01.66,0:00:04.42,Default,,0,0,0,,{\fs17\an7\fe162\b\fad(400,400)\bord2\blur5\shad\4c&H000000&\4a&HFF&\fnSweetest Cat Ever\pos(6,-5.67)}\N{\pos(20,1)}{\c&HFFFF00&}{\4c&H8485E4&}SomeSub ekip arkadaşı arıyor!\N{\pos(60,63)}{\c&HFFFFFF&}Çevirmen:{\c&HFFFF00&} Patrol\N{\pos(60,111)}{\c&HFFFFFF&}Encode:{\c&HFFFF00&} Patrol\N{\pos(60,111)}{\c&HFFFFFF&}Redaktör:{\c&HFFFF00&} Patrol\N{\c&HFFFFFF&}Discord:{\c&HFFFF00&} discord.gg/somesub
Dialogue: 0,0:00:05.13,0:00:06.46,Default,,0,0,0,,geleceği değiştirdikten sonra,
Dialogue: 0,0:00:07.38,0:00:11.63,Default,,0,0,0,,benim yaptığım gibi başkası\N gelip yine değiştirirse? \N
Dialogue: 0,0:00:11.63,0:00:13.22,Default,,0,0,0,,Acaba…
Dialogue: 0,0:00:13.22,0:00:16.09,Default,,0,0,0,,Belki Kisaki de benim gibi \Nzamanda yolculuk yapabiliyordur.
Dialogue: 0,0:00:17.39,0:00:19.06,Default,,0,0,0,,Takemitchy…
Dialogue: 0,0:00:19.56,0:00:20.56,Default,,0,0,0,,Hı?
Dialogue: 0,0:00:21.56,0:00:23.48,Default,,0,0,0,,Mikey'ye iyi bak…
Dialogue: 0,0:00:24.56,0:00:26.65,Default,,0,0,0,,benim yerime, tamam mı?
Dialogue: 0,0:00:31.78,0:00:37.53,Default,,0,0,0,,Sonuçta benim Shinichiro ile \Nne de Emma, Mikey veya başkasıyla kan bağım var.
Dialogue: 0,0:00:38.70,0:00:40.16,Default,,0,0,0,,İşte orada, Mikey.
Dialogue: 0,0:00:41.29,0:00:42.37,Default,,0,0,0,,Eee, şimdi ne olacak?
Dialogue: 0,0:00:42.37,0:00:44.08,Default,,0,0,0,,Beni kurtarmak istemiyor musun?
Dialogue: 0,0:00:49.42,0:00:52.26,Default,,0,0,0,,Kaçamazsın! Sakın yapma!
Dialogue: 0,0:00:52.26,0:00:55.47,Default,,0,0,0,,Geleceğe dönmene izin vermeyeceğim \Nbir daha asla, Kisaki!
Dialogue: 0,0:01:00.60,0:01:03.39,Default,,0,0,0,,"Geleceğe dönmek" mi dedin. Cidden mi?
Dialogue: 0,0:01:03.39,0:01:04.52,Default,,0,0,0,,Hı?
Dialogue: 0,0:01:04.52,0:01:09.15,Default,,0,0,0,,Anladım. Zaman yolcusu olduğumu \Nsanıp beni durdurmaya çalışıyorsun.
Dialogue: 0,0:01:09.15,0:01:11.11,Default,,0,0,0,,Yani değil misin?
Dialogue: 0,0:01:11.65,0:01:12.73,Default,,0,0,0,,Şey, ben--
Dialogue: 0,0:01:16.28,0:01:17.61,Default,,0,0,0,,Kisaki öldü.
Dialogue: 0,0:01:18.74,0:01:20.87,Default,,0,0,0,,Yani kavgam bitti demek, değil mi?
Dialogue: 0,0:01:22.37,0:01:23.58,Default,,0,0,0,,Ama…
Dialogue: 0,0:01:24.08,0:01:28.17,Default,,0,0,0,,nedense, Kisaki öldüğünden beri,
Dialogue: 0,0:01:28.17,0:01:31.34,Default,,0,0,0,,ellerim titreyip duruyor.
Dialogue: 0,0:03:01.97,0:03:04.01,Default,,0,0,0,,{\an8}MERHUM EMMASANO'NUN\NCENAZE TÖRENİ
Dialogue: 0,0:03:05.22,0:03:07.31,Default,,0,0,0,,{\an8}KABUL
Dialogue: 0,0:03:30.41,0:03:31.50,Default,,0,0,0,,{\an8}MERHUM EMMASANO
Dialogue: 0,0:03:31.50,0:03:35.00,Default,,0,0,0,,{\an8}Geldiğiniz için teşekkürler. Bugün, aramızdan erken ayrılan kız kardeşim Emma'yı anıyoruz.\N
Dialogue: 0,0:03:35.00,0:03:36.29,Default,,0,0,0,,{\an8}Teşekkür ederiz.
Dialogue: 0,0:03:37.38,0:03:42.22,Default,,0,0,0,,Emma 22 Şubat'ta \Nbeklenmedik bir kaza sonucu hayatını kaybetti.
Dialogue: 0,0:03:42.22,0:03:45.18,Default,,0,0,0,,{\an8}Emma'yı her zaman kollayan \Nve bugün ona son görevini yerine getirmek için
Dialogue: 0,0:03:45.18,0:03:47.85,Default,,0,0,0,,{\an8}buraya gelen hepinize minnettarım,
Dialogue: 0,0:03:48.43,0:03:51.14,Default,,0,0,0,,kalbimin derinliklerinden teşekkür ederim.
Dialogue: 0,0:03:58.57,0:04:01.19,Default,,0,0,0,,Mikey hiç istifini bozmadı.
Dialogue: 0,0:04:09.29,0:04:10.29,Default,,0,0,0,,Draken.
Dialogue: 0,0:04:16.00,0:04:17.67,Default,,0,0,0,,Emma'yı çok seviyordum.
Dialogue: 0,0:04:22.80,0:04:24.26,Default,,0,0,0,,Lütfen beni bağışla.
Dialogue: 0,0:04:24.76,0:04:27.85,Default,,0,0,0,,Sonunda, onu… koruyamadım.
Dialogue: 0,0:04:35.35,0:04:37.23,Default,,0,0,0,,Anlıyorum.
Dialogue: 0,0:04:37.23,0:04:39.23,Default,,0,0,0,,Demek sen de Emma'yı seviyordun.
Dialogue: 0,0:04:42.03,0:04:45.07,Default,,0,0,0,,Eminim şu an bile sevgini hissediyordur.
Dialogue: 0,0:05:05.63,0:05:09.60,Default,,0,0,0,,{\an8}MERHUM SANO
Dialogue: 0,0:05:20.52,0:05:21.53,Default,,0,0,0,,Yo.
Dialogue: 0,0:05:25.24,0:05:26.24,Default,,0,0,0,,Koko.
Dialogue: 0,0:05:31.70,0:05:34.08,Default,,0,0,0,,Sanırım kendi yoluma gitme vaktim geldi.
Dialogue: 0,0:05:39.04,0:05:41.09,Default,,0,0,0,,Artık seninle beraber yürümeyeceğim,
Dialogue: 0,0:05:41.09,0:05:44.92,Default,,0,0,0,,bu yüzden dikkatli ol \Nve yolunu kaybetme, tamam mı?
Dialogue: 0,0:05:47.80,0:05:49.05,Default,,0,0,0,,Kendine iyi bak.
Dialogue: 0,0:05:51.35,0:05:52.47,Default,,0,0,0,,Evet.
Dialogue: 0,0:05:56.27,0:05:58.35,Default,,0,0,0,,Yaptığın her şey için teşekkürler.
Dialogue: 0,0:05:59.60,0:06:00.98,Default,,0,0,0,,Aptal.
Dialogue: 0,0:06:15.62,0:06:17.12,Default,,0,0,0,,- Kar yağdı!\N- Kar yağdı!
Dialogue: 0,0:06:26.26,0:06:27.88,Default,,0,0,0,,Fena kesilmiş, ha?
Dialogue: 0,0:06:30.47,0:06:32.18,Default,,0,0,0,,Bunu kime yapıyorsun?
Dialogue: 0,0:06:35.14,0:06:38.35,Default,,0,0,0,,Huzur içinde yat, Izana. Elveda.
Dialogue: 0,0:06:54.16,0:06:57.90,Default,,0,0,0,,Emma Sano ve Izana Kurokawa'nın\Nölümleri resmen cinayet olarak kayda geçti.
Dialogue: 0,0:06:57.90,0:07:00.46,Default,,0,0,0,,Baş fail olarak Tetta Kisaki,
Dialogue: 0,0:07:00.46,0:07:05.13,Default,,0,0,0,,suç ortağı olarak da \NShuji Hanma olarak belirlendi.
Dialogue: 0,0:07:26.57,0:07:29.03,Default,,0,0,0,,Cidden mi? Yine mi olay?
Dialogue: 0,0:07:29.03,0:07:31.99,Default,,0,0,0,,Dünya günden güne daha\Ntehlikeli bir yere dönüyor sanki.
Dialogue: 0,0:07:31.99,0:07:34.41,Default,,0,0,0,,- Hesabı alayım.\N- Tabii ki, evlat!
Dialogue: 0,0:07:35.49,0:07:38.75,Default,,0,0,0,,Şaka gibi.\NDünyayı heyecanlı kılan şey tehlike zaten.
Dialogue: 0,0:07:39.37,0:07:41.00,Default,,0,0,0,,Eline sağlık, ihtiyar!
Dialogue: 0,0:07:46.92,0:07:49.30,Default,,0,0,0,,Böyle kaçak yaşamak aşırı sıkıcı ya.
Dialogue: 0,0:07:52.26,0:07:55.93,Default,,0,0,0,,Bugün bile\NShuji Hanma hala firari.
Dialogue: 0,0:08:06.36,0:08:08.40,Default,,0,0,0,,Tamamdır. Karar verdim.
Dialogue: 0,0:08:12.45,0:08:14.15,Default,,0,0,0,,Bir, iki, üç, dört,
Dialogue: 0,0:08:14.16,0:08:17.20,Default,,0,0,0,,beş, altı, yedi, sekiz, dokuz, on,\Non bir, on iki...
Dialogue: 0,0:08:17.20,0:08:20.04,Default,,0,0,0,,Görüyor musun, Takemitchy?\NYeni bir rekor kırdım.
Dialogue: 0,0:08:21.25,0:08:23.25,Default,,0,0,0,,Hı-hı. Güzel.
Dialogue: 0,0:08:27.88,0:08:29.05,Default,,0,0,0,,Tamam.
Dialogue: 0,0:08:31.17,0:08:33.92,Default,,0,0,0,,Bak dostum, nasıl hissettiğini anlıyorum.
Dialogue: 0,0:08:33.93,0:08:37.09,Default,,0,0,0,,Emma artık yok,\NIzana da aramızdan ayrıldı,
Dialogue: 0,0:08:37.10,0:08:38.89,Default,,0,0,0,,- anlıyorum ki--\N- Mesele o değil.
Dialogue: 0,0:08:39.47,0:08:40.60,Default,,0,0,0,,Ha?
Dialogue: 0,0:08:40.60,0:08:44.35,Default,,0,0,0,,Kisaki'nin kim olduğu kafama takılıp duruyor.
Dialogue: 0,0:08:44.35,0:08:45.60,Default,,0,0,0,,He.
Dialogue: 0,0:08:47.90,0:08:50.11,Default,,0,0,0,,Olay şu ki, her şeyi yanlış anlamışım.
Dialogue: 0,0:08:50.82,0:08:53.57,Default,,0,0,0,,Sonuçta Kisaki zamanda yolculuk yapan biri değilmiş.
Dialogue: 0,0:08:53.57,0:08:56.32,Default,,0,0,0,,- Ne?\N- Sadece tek bir ömürde,
Dialogue: 0,0:08:56.32,0:08:58.95,Default,,0,0,0,,Toman'ın liderlerini\Nyönlendirmeyi başardı,
Dialogue: 0,0:08:59.45,0:09:01.08,Default,,0,0,0,,düşmanlarını ortadan kaldırdı
Dialogue: 0,0:09:01.58,0:09:04.46,Default,,0,0,0,,ve tek başına Japonya'nın\Nen büyük çetelerinin tepesine tırmandı.
Dialogue: 0,0:09:06.00,0:09:09.54,Default,,0,0,0,,Tüm bunları başarmak için\Nkaç gecesini uykusuz geçirdi kim bilir?
Dialogue: 0,0:09:11.21,0:09:14.34,Default,,0,0,0,,En iyi dövüşçü olmadığı bariz.
Dialogue: 0,0:09:15.13,0:09:17.68,Default,,0,0,0,,Zirveye çıkmak için\Nsadece zekasını kullanması yetti.
Dialogue: 0,0:09:18.30,0:09:19.68,Default,,0,0,0,,Buna saygı duymam lazım.
Dialogue: 0,0:09:19.68,0:09:22.01,Default,,0,0,0,,Sen ne saçmalıyorsun Takemitchy!?
Dialogue: 0,0:09:22.02,0:09:24.89,Default,,0,0,0,,Kisaki'nin nasıl tırmandığı\Nkimin umurunda?
Dialogue: 0,0:09:24.89,0:09:26.31,Default,,0,0,0,,Hala pisliğin teki.
Dialogue: 0,0:09:27.02,0:09:29.77,Default,,0,0,0,,Neden onun için\Nenerjini harcıyorsun?
Dialogue: 0,0:09:29.77,0:09:31.78,Default,,0,0,0,,O herif ölmeyi hak etmişti.
Dialogue: 0,0:09:32.36,0:09:34.07,Default,,0,0,0,,- Sadece şunu demek istedim--\N- Ha?
Dialogue: 0,0:09:38.03,0:09:40.70,Default,,0,0,0,,Hey! Ne yapıyorsun sen?
Dialogue: 0,0:09:42.66,0:09:43.83,Default,,0,0,0,,Takemitchy!
Dialogue: 0,0:09:51.17,0:09:53.21,Default,,0,0,0,,Neden yaptın bunu be aptal?
Dialogue: 0,0:09:53.21,0:09:55.09,Default,,0,0,0,,- Chifuyu!\N- Hı?
Dialogue: 0,0:09:55.09,0:09:58.84,Default,,0,0,0,,İnan bana,Kisaki'den en az senin \Nkadar nefret ediyorum.
Dialogue: 0,0:09:58.84,0:10:00.76,Default,,0,0,0,,Bize yaptıklarından nefret ediyorum.
Dialogue: 0,0:10:03.89,0:10:06.98,Default,,0,0,0,,Onu yaptıklarından dolayı\Nasla affedemem!
Dialogue: 0,0:10:12.40,0:10:16.32,Default,,0,0,0,,Ama öldüğü gün,\Nher şeyin Hina için olduğunu söyledi.
Dialogue: 0,0:10:16.90,0:10:19.28,Default,,0,0,0,,Hatta bana\Nsaygı duyduğunu bile söyledi!
Dialogue: 0,0:10:21.03,0:10:23.33,Default,,0,0,0,,Bilmiyordum. O yüzden...
Dialogue: 0,0:10:24.49,0:10:27.87,Default,,0,0,0,,Keşke meseleleri halletmek için\Ngerçek bir şansımız olsaydı!
Dialogue: 0,0:10:29.92,0:10:31.13,Default,,0,0,0,,Lanet olsun!
Dialogue: 0,0:10:34.09,0:10:36.63,Default,,0,0,0,,Üşüteceksin burada,\NTakemitchy.
Dialogue: 0,0:10:38.55,0:10:41.43,Default,,0,0,0,,Ee, nasıl hissediyorsun? Daha iyi misin?
Dialogue: 0,0:10:42.64,0:10:46.35,Default,,0,0,0,,Bilmiyorum.\NÖlümü hiç doğru gelmiyor.
Dialogue: 0,0:10:46.35,0:10:48.98,Default,,0,0,0,,Evet. Ne demek istediğini anlıyorum.
Dialogue: 0,0:10:55.32,0:10:57.24,Default,,0,0,0,,Ne kadar kötü biri olursa olsun,
Dialogue: 0,0:10:58.53,0:11:00.99,Default,,0,0,0,,tanıdığın birini kaybetmek asla kolay değildir.
Dialogue: 0,0:11:02.12,0:11:04.00,Default,,0,0,0,,Bana hayranlık duyduğunu söyledi.
Dialogue: 0,0:11:04.41,0:11:08.83,Default,,0,0,0,,Ya da en azından, o son kavgada\Nöyle bir şeyler diyordu.
Dialogue: 0,0:11:08.83,0:11:13.79,Default,,0,0,0,,Yine de anlamıyorum.\NBenim gibi birine neden hayran olsun ki?
Dialogue: 0,0:11:13.79,0:11:16.63,Default,,0,0,0,,Eh, en azından insan sarrafıymış.
Dialogue: 0,0:11:16.63,0:11:17.63,Default,,0,0,0,,Efendim?
Dialogue: 0,0:11:18.55,0:11:19.76,Default,,0,0,0,,Bir şey demedim.
Dialogue: 0,0:11:31.23,0:11:33.06,Default,,0,0,0,,MUSASHI TAPINAĞI
Dialogue: 0,0:11:35.23,0:11:36.52,Default,,0,0,0,,Hey, Mikey.
Dialogue: 0,0:11:36.52,0:11:38.44,Default,,0,0,0,,Seni buraya çağırdığım için kusura bakma.
Dialogue: 0,0:11:39.36,0:11:41.15,Default,,0,0,0,,Seninle baş başa konuşmak istedim.
Dialogue: 0,0:11:41.99,0:11:43.82,Default,,0,0,0,,Sana bir şey sormam lazım.
Dialogue: 0,0:11:45.53,0:11:49.29,Default,,0,0,0,,Gelecekten geldiğini biliyorum ama...\Nher şeyin nasıl başladığını anlatır mısın?
Dialogue: 0,0:11:52.37,0:11:53.37,Default,,0,0,0,,Elbette.
Dialogue: 0,0:11:55.04,0:12:00.05,Default,,0,0,0,,Kendi zaman çizelgemde 26 yaşındaydım\Nve geçinmek için yarı zamanlı işlerde çalışıyordum.
Dialogue: 0,0:12:01.01,0:12:03.97,Default,,0,0,0,,Ne yaparsam yapayım, hiçbir şey yolunda gitmiyordu.
Dialogue: 0,0:12:03.97,0:12:08.47,Default,,0,0,0,,Ama dürüst olmak gerekirse, asıl sebep\Nartık hiçbir şeyi umursamamamdı.
Dialogue: 0,0:12:08.47,0:12:13.31,Default,,0,0,0,,Bir gün haberlerde Toman'ın karıştığı\Nbir yakuza çatışmasını duydum,
Dialogue: 0,0:12:13.31,0:12:15.77,Default,,0,0,0,,Hina da arada kaynadı\Nve öldü.
Dialogue: 0,0:12:16.56,0:12:21.11,Default,,0,0,0,,O güne kadar onu neredeyse unutmuş,\Numutsuz bir eziktim.
Dialogue: 0,0:12:21.11,0:12:23.49,Default,,0,0,0,,Hayatımda sahip olduğum tek kız arkadaşıydı.
Dialogue: 0,0:12:24.91,0:12:31.54,Default,,0,0,0,,Ve sonra, 4 Temmuz 2017'de,\Nbiri beni tren raylarına itti.
Dialogue: 0,0:12:32.33,0:12:35.12,Default,,0,0,0,,Benim için yolun sonu sandım,\Nama bir şeyler oldu.
Dialogue: 0,0:12:35.12,0:12:37.42,Default,,0,0,0,,2005 yılına dönmüştüm.
Dialogue: 0,0:12:38.46,0:12:40.92,Default,,0,0,0,,Mizo Ortaokulundan arkadaşlarımla
Dialogue: 0,0:12:40.92,0:12:43.38,Default,,0,0,0,,\NKiyomasa ve çetesi tarafından dövüldüğümüz gündü.
Dialogue: 0,0:12:43.38,0:12:46.59,Default,,0,0,0,,Aynı zamanda köleleri olmaya\Nzorlandığımız gündü.
Dialogue: 0,0:12:47.14,0:12:50.72,Default,,0,0,0,,İlk başta hayatımın gözlerimin önünden\Ngelip geçtiğini sandım.
Dialogue: 0,0:12:51.93,0:12:53.98,Default,,0,0,0,,Ama bir şekilde, bunun farklı olduğunu biliyordum.
Dialogue: 0,0:12:57.36,0:13:02.40,Default,,0,0,0,,Sonra Hina ile karşılaştım ve onun öylece\Nölüp gitmesine izin veremeyeceğimi anladım.
Dialogue: 0,0:13:04.28,0:13:05.99,Default,,0,0,0,,İşte her şey böyle başladı.
Dialogue: 0,0:13:09.20,0:13:11.29,Default,,0,0,0,,Ne kadar süredir konuşuyorduk?
Dialogue: 0,0:13:11.29,0:13:14.83,Default,,0,0,0,,Mikey yanıma oturdu\Nsessizce her söylediğimi dinledi.
Dialogue: 0,0:13:15.75,0:13:17.67,Default,,0,0,0,,Sanırım içimi dökmeme izin veriyordu.
Dialogue: 0,0:13:18.71,0:13:23.38,Default,,0,0,0,,Kelimeler döküldükçe, yaşanan her şeyi\Nhatırlamaya başladım,
Dialogue: 0,0:13:23.38,0:13:25.34,Default,,0,0,0,,duygularım yeniden sel olup aktı.
Dialogue: 0,0:13:29.39,0:13:31.89,Default,,0,0,0,,Ve sürekli bunu düzeltmek için geri döndüm, ama...
Dialogue: 0,0:13:32.39,0:13:35.52,Default,,0,0,0,,Emma ya da Baji'yi kurtaramadım.
Dialogue: 0,0:13:36.31,0:13:38.35,Default,,0,0,0,,Hepsi benim yüzümden öldü!
Dialogue: 0,0:13:41.57,0:13:42.98,Default,,0,0,0,,Çok özür dilerim.
Dialogue: 0,0:13:43.74,0:13:44.78,Default,,0,0,0,,Özür dilerim.
Dialogue: 0,0:13:45.82,0:13:49.07,Default,,0,0,0,,Lütfen beni affet, Mikey!
Dialogue: 0,0:13:55.20,0:13:56.91,Default,,0,0,0,,Farklı olduğunu biliyordum.
Dialogue: 0,0:13:56.91,0:13:58.29,Default,,0,0,0,,Efendim?
Dialogue: 0,0:13:59.38,0:14:01.33,Default,,0,0,0,,Seni okulda ilk gördüğümde,
Dialogue: 0,0:14:01.34,0:14:05.26,Default,,0,0,0,,Kiyomasa seni yer altı dövüşlerinde\Ndöve döve bir hâl etmişti.
Dialogue: 0,0:14:05.88,0:14:09.97,Default,,0,0,0,,Ama seni kaç kez yere sererse sersin,\Nher seferinde ayağa kalktın.
Dialogue: 0,0:14:09.97,0:14:13.31,Default,,0,0,0,,Bu da bana dünyanın yükünü omuzlarında\Ntaşıyabileceğini gösterdi.
Dialogue: 0,0:14:13.93,0:14:17.19,Default,,0,0,0,,Yani sen... sen gerçekten ortaokullu musun?
Dialogue: 0,0:14:18.85,0:14:20.44,Default,,0,0,0,,Hiç değişmemişsin.
Dialogue: 0,0:14:22.73,0:14:25.11,Default,,0,0,0,,Takemitchy, sana hayranlık duyuyorum.
Dialogue: 0,0:14:31.41,0:14:33.45,Default,,0,0,0,,BİRİNCİ JENERASYON LİDERİ
Dialogue: 0,0:14:33.45,0:14:36.41,Default,,0,0,0,,{\an8}Yeni bir dönemi başlatacak kişinin\Nben olacağımı sanırdım.
Dialogue: 0,0:14:40.46,0:14:42.25,Default,,0,0,0,,Ayağa kalk, Takemitchy.
Dialogue: 0,0:14:43.42,0:14:44.88,Default,,0,0,0,,Bunu duyabiliyor musun?
Dialogue: 0,0:14:44.88,0:14:46.26,Default,,0,0,0,,TOKYO MANJI ÇETESİ
Dialogue: 0,0:14:46.84,0:14:48.42,Default,,0,0,0,,Değişimin ayak sesleri bunlar.
Dialogue: 0,0:14:50.76,0:14:53.14,Default,,0,0,0,,Pes etmeyi reddettin.
Dialogue: 0,0:14:53.14,0:14:56.02,Default,,0,0,0,,Bana sorarsan,\NToman'lı olmak da tam olarak budur.
Dialogue: 0,0:14:57.06,0:14:59.69,Default,,0,0,0,,Bugün Toman için yepyeni bir gün.
Dialogue: 0,0:15:11.70,0:15:13.66,Default,,0,0,0,,Hepimiz senin sayende buradayız.
Dialogue: 0,0:15:18.66,0:15:20.79,Default,,0,0,0,,Artık vakti geldi.
Dialogue: 0,0:15:22.21,0:15:23.42,Default,,0,0,0,,Dinleyin beyler!
Dialogue: 0,0:15:24.09,0:15:27.42,Default,,0,0,0,,Ağır bir bedel ödedik\Nama Tenjiku'yu ezip geçtik,
Dialogue: 0,0:15:27.42,0:15:29.84,Default,,0,0,0,,ve Toman onların külleri üzerine kuruldu.
Dialogue: 0,0:15:29.84,0:15:34.10,Default,,0,0,0,,Senin sayende artık zirvede olduğumuz\Nbir döneme giriyoruz.
Dialogue: 0,0:15:35.30,0:15:38.98,Default,,0,0,0,,İşte tam da bu yüzden\Nher şeyi bitirmek için en doğru zaman.
Dialogue: 0,0:15:40.02,0:15:41.02,Default,,0,0,0,,Efendim?
Dialogue: 0,0:15:41.56,0:15:46.07,Default,,0,0,0,,Bugünden itibaren,\NTokyo Manji Çetesi dağıtılmıştır!
Dialogue: 0,0:15:49.53,0:15:53.36,Default,,0,0,0,,Bugünden itibaren,\NTokyo Manji Çetesi dağıtılmıştır!
Dialogue: 0,0:15:54.82,0:15:56.53,Default,,0,0,0,,- Ne?\N- Dağıtıldı mı?
Dialogue: 0,0:15:56.53,0:15:59.49,Default,,0,0,0,,Mikey, ne saçmalıyorsun sen?
Dialogue: 0,0:15:59.50,0:16:01.62,Default,,0,0,0,,Ciddi misin? Ne düşünüyorsun acaba?
Dialogue: 0,0:16:01.62,0:16:03.33,Default,,0,0,0,,Dağıtıldı mı dedi o?
Dialogue: 0,0:16:03.33,0:16:05.88,Default,,0,0,0,,- Bu imkansız.\N- Toman'ın sonu bu olamaz.
Dialogue: 0,0:16:07.34,0:16:11.05,Default,,0,0,0,,Birinci Bölük Kaptanı Takemichi Hanagaki,\Nöne gel.
Dialogue: 0,0:16:11.05,0:16:14.26,Default,,0,0,0,,- Bunu neden yapıyor?\N- Bunca yolu geldikten sonra?
Dialogue: 0,0:16:14.26,0:16:17.30,Default,,0,0,0,,Geleceği değiştirmek istiyorsak,\Nen iyi yol bu değil mi?
Dialogue: 0,0:16:17.31,0:16:19.47,Default,,0,0,0,,Bunu bir konuşalım. Bir saniye.
Dialogue: 0,0:16:19.47,0:16:23.06,Default,,0,0,0,,İkinci Bölük Kaptanı Takashi Mitsuya,\Nöne gel!
Dialogue: 0,0:16:28.86,0:16:29.86,Default,,0,0,0,,Mikey.
Dialogue: 0,0:16:30.53,0:16:33.74,Default,,0,0,0,,Hizmetlerin için teşekkürler.\NSen olmasan başaramazdık.
Dialogue: 0,0:16:33.74,0:16:36.20,Default,,0,0,0,,Bekle. Bir saniye dur.
Dialogue: 0,0:16:36.20,0:16:39.45,Default,,0,0,0,,Üçüncü Bölük Başkan Yardımcısı\NRyohei Hayashi!
Dialogue: 0,0:16:41.00,0:16:43.96,Default,,0,0,0,,Pah-chin hapse girdiğinde,\Ngörevini layıkıyla yaptın.
Dialogue: 0,0:16:44.58,0:16:47.17,Default,,0,0,0,,Bizi gururlandırdın, Başkan Yardımcısı.
Dialogue: 0,0:16:47.17,0:16:48.42,Default,,0,0,0,,Mikey.
Dialogue: 0,0:16:48.42,0:16:51.42,Default,,0,0,0,,4. Tümen Kaptanı Nahoya Kawata!
Dialogue: 0,0:16:53.01,0:16:56.59,Default,,0,0,0,,Toman'ı hep ayakta tuttun, Smiley,\Nbu yüzden teşekkürler.
Dialogue: 0,0:16:56.59,0:16:59.14,Default,,0,0,0,,Ciddi misin, lütfen öyle konuşma artık.
Dialogue: 0,0:16:59.72,0:17:01.56,Default,,0,0,0,,Mikey, ben bunu istemiyorum.
Dialogue: 0,0:17:01.56,0:17:04.52,Default,,0,0,0,,5. Tümen Kaptanı Yasuhiro Muto!
Dialogue: 0,0:17:04.52,0:17:07.15,Default,,0,0,0,,Şu an parmaklıklar ardında olsa da,
Dialogue: 0,0:17:07.15,0:17:09.90,Default,,0,0,0,,her zaman Toman'ın mirasının\Nönemli bir parçası olarak kalacak!
Dialogue: 0,0:17:11.23,0:17:17.03,Default,,0,0,0,,Ve son olarak, Tokyo Manji Çetesi'nin\NBaşkan Yardımcısı, Ken Ryuguji.
Dialogue: 0,0:17:23.04,0:17:27.29,Default,,0,0,0,,Manjiro Sano,\Nçok bencil bir herifsin.
Dialogue: 0,0:17:27.29,0:17:30.09,Default,,0,0,0,,Dünya senin etrafında dönüyormuş gibi\Nhareket edip duruyorsun.
Dialogue: 0,0:17:30.96,0:17:35.88,Default,,0,0,0,,Ama bizi peşinden sürükleyen ve sonuna kadar\Npeinden gitmemizi sağlayan da o karizman.
Dialogue: 0,0:17:36.63,0:17:39.55,Default,,0,0,0,,Liderimizin kararına\Nhiçbir itirazım yok.
Dialogue: 0,0:17:40.64,0:17:44.89,Default,,0,0,0,,Bizim için yaptığın her şey için\Nteşekkürler Kaptan!
Dialogue: 0,0:17:58.91,0:18:00.70,Default,,0,0,0,,Bunun için teşekkürler, Kenny.
Dialogue: 0,0:18:01.28,0:18:02.74,Default,,0,0,0,,Toman!
Dialogue: 0,0:18:02.74,0:18:09.25,Default,,0,0,0,,Toman! Toman! Toman! Toman!
Dialogue: 0,0:18:09.25,0:18:12.09,Default,,0,0,0,,Toman bugün dağılıyor olsa da,
Dialogue: 0,0:18:12.09,0:18:15.51,Default,,0,0,0,,Toman'ın ruhu hepimizin içinde\Nyaşamaya devam edecek.
Dialogue: 0,0:18:15.51,0:18:17.01,Default,,0,0,0,,O yüzden başınızı dik tutun!
Dialogue: 0,0:18:17.59,0:18:19.05,Default,,0,0,0,,Asla unutmamanız gereken şey
Dialogue: 0,0:18:19.05,0:18:22.35,Default,,0,0,0,,{\an8}Toman'ın ateşinin\Nkalplerinizde hep yanacağıdır!
Dialogue: 0,0:18:27.48,0:18:30.94,Default,,0,0,0,,BİR HAFTA SONRA, 15 MART 2006
Dialogue: 0,0:18:38.03,0:18:39.61,Default,,0,0,0,,Bu iş tamamdır.
Dialogue: 0,0:18:51.46,0:18:53.38,Default,,0,0,0,,Hala kabullenmesi zor, dostum.
Dialogue: 0,0:18:54.67,0:18:57.71,Default,,0,0,0,,Yani Toman gerçekten bitiyor, değil mi?
Dialogue: 0,0:18:57.72,0:18:59.26,Default,,0,0,0,,Evet. Sanırım öyle.
Dialogue: 0,0:18:59.80,0:19:03.76,Default,,0,0,0,,Ama biliyor musun, Mikey'nin yerinde\Nolsam, muhtemelen ben de aynısını yapardım.
Dialogue: 0,0:19:03.76,0:19:07.93,Default,,0,0,0,,Çünkü düşünürsen,\Nhepimizden çok o kaybetti.
Dialogue: 0,0:19:09.69,0:19:11.19,Default,,0,0,0,,- Takemitchy?\N- Hı?
Dialogue: 0,0:19:11.77,0:19:14.11,Default,,0,0,0,,Toman bittiğine göre, planın ne?
Dialogue: 0,0:19:14.11,0:19:15.44,Default,,0,0,0,,Nasıl yani?
Dialogue: 0,0:19:15.44,0:19:18.78,Default,,0,0,0,,Yani, Toman dağıldığına\Nve Kisaki de aradan çıktığına göre,
Dialogue: 0,0:19:19.28,0:19:21.82,Default,,0,0,0,,geçmişte kalman için bir sebep\Nkalmadı, değil mi?
Dialogue: 0,0:19:21.82,0:19:23.87,Default,,0,0,0,,Kisaki öldüğüne göre,
Dialogue: 0,0:19:23.87,0:19:26.58,Default,,0,0,0,,gelecekte Naoto'yu öldürmesi\Nartık imkansız.
Dialogue: 0,0:19:28.87,0:19:33.00,Default,,0,0,0,,Ve Naoto hayatta olduğuna göre,\Ntekrar Zamanda Sıçrama yapabilmeliyim.
Dialogue: 0,0:19:33.00,0:19:34.46,Default,,0,0,0,,Hmm.
Dialogue: 0,0:19:34.46,0:19:37.51,Default,,0,0,0,,Bu sefer geri döndüğümde,\Nher şey daha iyi olacak.
Dialogue: 0,0:19:39.42,0:19:41.38,Default,,0,0,0,,Hı? Ne oldu?
Dialogue: 0,0:19:41.38,0:19:45.89,Default,,0,0,0,,Yaşanan onca şeyden sonra, geçmişteki herkes\Nkardeşim gibi oldu.
Dialogue: 0,0:19:46.85,0:19:47.93,Default,,0,0,0,,Anladım.
Dialogue: 0,0:19:47.93,0:19:51.39,Default,,0,0,0,,Dostum, veda etmek çok zor.
Dialogue: 0,0:19:51.39,0:19:52.81,Default,,0,0,0,,Asla kolay değildir.
Dialogue: 0,0:19:53.85,0:19:55.73,Default,,0,0,0,,Herkesi gerçekten çok özleyeceğim.
Dialogue: 0,0:19:57.78,0:19:59.69,Default,,0,0,0,,- Hey, millet!\N- Hı?
Dialogue: 0,0:19:59.69,0:20:02.78,Default,,0,0,0,,Toman'ın sonunu simgeleyecek bir\Nzaman kapsülü gömelim.
Dialogue: 0,0:20:02.78,0:20:05.16,Default,,0,0,0,,- Ne kapsülü?\N- Neden zaman kapsülü?
Dialogue: 0,0:20:05.16,0:20:06.24,Default,,0,0,0,,Ne gerek var ki?
Dialogue: 0,0:20:06.24,0:20:07.45,Default,,0,0,0,,Güzel fikir.
Dialogue: 0,0:20:08.66,0:20:09.79,Default,,0,0,0,,Bakalım...
Dialogue: 0,0:20:11.29,0:20:13.46,Default,,0,0,0,,Gelecekteki kendimize \N mektup yazalım.
Dialogue: 0,0:20:13.46,0:20:14.79,Default,,0,0,0,,Mektup mu?
Dialogue: 0,0:20:14.79,0:20:17.34,Default,,0,0,0,,Hmm… Ne kadar beklemeliyiz?
Dialogue: 0,0:20:19.17,0:20:20.67,Default,,0,0,0,,12 yıl sonra açmaya ne dersiniz?
Dialogue: 0,0:20:21.47,0:20:22.68,Default,,0,0,0,,Bayağı uzun bir süre.
Dialogue: 0,0:20:26.39,0:20:28.30,Default,,0,0,0,,Neden 12 yıl dedi ki?
Dialogue: 0,0:20:28.31,0:20:30.39,Default,,0,0,0,,Ne bileyim. Yine de bana uyar.
Dialogue: 0,0:20:31.68,0:20:33.52,Default,,0,0,0,,Bir hafta sonra burada buluşalım.
Dialogue: 0,0:20:33.52,0:20:35.69,Default,,0,0,0,,Mektubu ve senin için \N önemli bir şeyi getir.
Dialogue: 0,0:20:35.69,0:20:36.73,Default,,0,0,0,,Anlaşıldı mı?
Dialogue: 0,0:20:38.65,0:20:40.19,Default,,0,0,0,,Ee, ne gömdün?
Dialogue: 0,0:20:40.19,0:20:43.15,Default,,0,0,0,,Söylersem \N büyüsü bozulur, geri zekalı.
Dialogue: 0,0:20:43.15,0:20:45.95,Default,,0,0,0,,On iki yıl ha? \N Bayağı uzak bir tarih.
Dialogue: 0,0:20:45.95,0:20:47.95,Default,,0,0,0,,Bugün koyduklarımızı \N unutacağız gibi hissediyorum.
Dialogue: 0,0:20:47.95,0:20:51.33,Default,,0,0,0,,Evet, aynen öyle. \N Zaman kapsülünün olayı bu zaten.
Dialogue: 0,0:20:51.33,0:20:54.08,Default,,0,0,0,,- Yani daha önce yaptın. \N - Hayatımda hiç.
Dialogue: 0,0:20:54.08,0:20:56.29,Default,,0,0,0,,- Aslında biraz heyecan verici. \N - Evet.
Dialogue: 0,0:20:56.29,0:20:58.38,Default,,0,0,0,,En azından \N dört gözle bekleyeceğimiz bir şey.
Dialogue: 0,0:21:00.96,0:21:02.84,Default,,0,0,0,,Takvimlerinize işaretleyin.
Dialogue: 0,0:21:03.42,0:21:07.59,Default,,0,0,0,,Bundan 12 yıl sonra 19 Haziran'da, \N Toman'ın kuruluş yıl dönümünde,
Dialogue: 0,0:21:07.60,0:21:09.31,Default,,0,0,0,,Hepinizi burada tekrar görmek istiyorum.
Dialogue: 0,0:21:15.19,0:21:18.31,Default,,0,0,0,,Hey dostum. Beni böyle uğurlaman \N benim için dünyalara bedel.
Dialogue: 0,0:21:20.36,0:21:22.73,Default,,0,0,0,,Veda vakti, Takemitchy.
Dialogue: 0,0:21:22.74,0:21:23.82,Default,,0,0,0,,Hmm?
Dialogue: 0,0:21:23.82,0:21:27.70,Default,,0,0,0,,Mesele şu ki, herkesin \N ait olduğu bir yer var.
Dialogue: 0,0:21:28.99,0:21:30.66,Default,,0,0,0,,Senin yerin burası değil, değil mi?
Dialogue: 0,0:21:30.66,0:21:31.66,Default,,0,0,0,,Hmm?
Dialogue: 0,0:21:33.16,0:21:34.25,Default,,0,0,0,,Biliyorum ama...
Dialogue: 0,0:21:34.25,0:21:37.50,Default,,0,0,0,,Takemitchy, endişelenmene gerek yok.
Dialogue: 0,0:21:38.25,0:21:40.25,Default,,0,0,0,,Söz veriyorum, tekrar görüşene kadar,
Dialogue: 0,0:21:40.75,0:21:44.34,Default,,0,0,0,,Toman'daki herkesi koruyacağım \N ve Hina'yı da güvende tutacağım.
Dialogue: 0,0:21:47.05,0:21:48.34,Default,,0,0,0,,Ne olursa olsun.
Dialogue: 0,0:21:49.39,0:21:51.26,Default,,0,0,0,,Sağ ol, Mikey.
Dialogue: 0,0:21:51.89,0:21:54.93,Default,,0,0,0,,Neden ağlıyorsun ki? \N Vedalaşmanın zor olduğunu biliyorum.
Dialogue: 0,0:21:55.52,0:21:57.52,Default,,0,0,0,,Artık eve dönme vaktin geldi, \N Takemitchy.
Dialogue: 0,0:21:58.60,0:22:01.90,Default,,0,0,0,,Hina senin dönmeni \N yeterince uzun süredir bekliyor.
Dialogue: 0,0:22:01.90,0:22:02.90,Default,,0,0,0,,Haklısın.
Dialogue: 0,0:23:40.92,0:23:42.58,Default,,0,0,0,,FAIRY TALE REVENGERS - PETIT \N #1 "MOMOTARO'NUN DÖNÜŞÜ"
Dialogue: 0,0:23:42.58,0:23:43.67,Default,,0,0,0,,- Fairy Tale Revengers. \N - Fairy Tale Revengers.
Dialogue: 0,0:23:43.67,0:23:46.00,Default,,0,0,0,,Söz verdiğim kaburga kasesi burada.
Dialogue: 0,0:23:46.00,0:23:47.92,Default,,0,0,0,,Vay, çok lezzetli görünüyor!
Dialogue: 0,0:23:47.92,0:23:50.42,Default,,0,0,0,,Gemi yolculuğundan sonra \N mükemmel bir ödül oldu.
Dialogue: 0,0:23:53.18,0:23:56.22,Default,,0,0,0,,Umarım yakında daha fazla \N maceraya atılabiliriz.
Dialogue: 0,0:23:56.22,0:23:58.39,Default,,0,0,0,,- Kokla kokla, kokla kokla. \N - Kokla kokla, kokla kokla.
Dialogue: 0,0:23:58.39,0:24:01.27,Default,,0,0,0,,Vay canına. Cennet gibi kokuyor, Mikey.
Dialogue: 0,0:24:01.27,0:24:03.06,Default,,0,0,0,,Siz de ister misiniz?
Dialogue: 0,0:24:03.06,0:24:04.65,Default,,0,0,0,,Tabii, ikram ediyorsan.
Dialogue: 0,0:24:04.65,0:24:06.73,Default,,0,0,0,,- Teşekkürler, Mikey! \N - Hı?
Dialogue: 0,0:24:07.23,0:24:10.53,Default,,0,0,0,,Yavaş olun. Biraz da bize bırakın.
Dialogue: 0,0:24:10.53,0:24:12.82,Default,,0,0,0,,Ama ben sadece bir tane yedim.
Dialogue: 0,0:24:12.82,0:24:14.78,Default,,0,0,0,,Hı?
Dialogue: 0,0:24:14.78,0:24:16.12,Default,,0,0,0,,Hey, şunlar onlar!
Dialogue: 0,0:24:16.87,0:24:17.99,Default,,0,0,0,,Ne zaman akıllanacaklar bunlar?
Dialogue: 0,0:24:17.99,0:24:20.87,Default,,0,0,0,,Benim kaburga kâseme nasıl el uzatırsın sen!
Dialogue: 0,0:24:20.87,0:24:22.50,Default,,0,0,0,,- Eyvah.\N- Geri gel buraya!
Dialogue: 0,0:24:22.50,0:24:24.75,Default,,0,0,0,,{\an8}Bekle!\NSeni öldüreceğim!
Dialogue: 0,0:24:24.75,0:24:26.84,Default,,0,0,0,,{\an8}DEVAM EDECEK
Dialogue: 0,0:06:00.98,0:06:02.57,Default,,0,0,0,,Görüşürüz.
